{
  "schema_version": 1,
  "title": "产教智对 revision17 条件分析审阅材料",
  "requirements": [
    {
      "requirement_id": "T1.skills",
      "status": "partial",
      "note": "补同校同届课程目标、能力观测、需求标签及共同口径的技能差距。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "T1.directions",
      "status": "partial",
      "note": "补现行方向人数及岗位族映射，计算方向差异。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "T1.scale",
      "status": "partial",
      "note": "补招生与毕业人数、有效岗位规模及代表性说明。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "T2.courses",
      "status": "partial",
      "note": "补新增、删减、合并或不采用理由，核定完整选课、内容承接和师资。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "T2.directions",
      "status": "partial",
      "note": "补方向容量来源与学生分流压力测试。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "T2.admissions",
      "status": "partial",
      "note": "补同窗就业反馈、规模上下界以及长期时滞稳定性。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "T3.validation",
      "status": "partial",
      "note": "G7 已补课程项目设计、流程对照与大学亚组 SMD 参照（0.116，CI [0.027,0.204]）及零/负/上行情景；目标措施仍 unidentified，本校效果论证待补。",
      "evidence": [
        "数据支撑/strategy-review.json",
        "数据支撑/data/evidence/course-projects.json",
        "数据支撑/data/examples/project-effect-scenarios.json"
      ]
    },
    {
      "requirement_id": "T4.risks",
      "status": "partial",
      "note": "补动作绑定的影响量、概率依据、责任时点和触发处置。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "S.evolution",
      "status": "partial",
      "note": "已验证有限候选失败触发修订与重新计算。自动从需求和课程关系提出更广方案仍待验证。",
      "evidence": [
        "数据支撑/strategy-review.json"
      ]
    },
    {
      "requirement_id": "D.report",
